{
  "name": "discord-channel-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "setup": "tsx --env-file=.env src/setup.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "start": "node dist/index.js",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.0.0",
    "typescript": "^7.0.2"
  }
}
